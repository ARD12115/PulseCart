# Copy to .env (never commit .env). Values come from the Aiven console.
PG_DSN=postgres://avnadmin:CHANGE_ME@HOST:PORT/defaultdb?sslmode=require
KAFKA_BOOTSTRAP=HOST:PORT
KAFKA_CA=certs/ca.pem
KAFKA_CERT=certs/service.cert
KAFKA_KEY=certs/service.key
OPENSEARCH_URL=https://avnadmin:CHANGE_ME@HOST:PORT

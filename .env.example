# Local Compose uses its own service URLs. These settings are for running processes locally.
PG_DSN=postgresql://postgres@localhost:5432/pulsecart
PG_PASSWORD=your_password_here
POSTGRES_PASSWORD=your_password_here
POSTGRES_HOST_PORT=5432
# If you customize this port, update the port in PG_DSN above for host-run clients.
KAFKA_BOOTSTRAP=localhost:9093
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CA=certs/ca.pem
KAFKA_CERT=certs/service.cert
KAFKA_KEY=certs/service.key
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
API_CORS_ORIGINS=http://localhost:3000
APP_ENV=production
API_DOCS_ENABLED=false
# Leave blank until you set a unique key in the ignored .env; never expose a placeholder key.
ADMIN_KEY=
TRUSTED_PROXY_IPS=

# Least-privilege app DB role (created by migration 004, password set by backend startup)
PULSECART_APP_PASSWORD=
# OpenSearch admin password (security plugin enabled)
OPENSEARCH_ADMIN_PASSWORD=

# Rate limits. Keep checkout strict by default; raise it for a busy live demo (e.g. 30/minute).
CHECKOUT_RATE_LIMIT=5/minute
CART_RATE_LIMIT=20/minute

# Order confirmation emails. Leave SMTP_HOST empty to only store and log confirmations
# (they still appear on /admin). Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Authentication requires STARTTLS; the worker refuses SMTP_USER with STARTTLS disabled.
SMTP_STARTTLS=true

# For Aiven, replace the service URLs above, set PG_PASSWORD separately from
# the password-free PG_DSN, and add ?sslmode=require to PG_DSN.
# KAFKA_SECURITY_PROTOCOL=SSL
# Set OPENSEARCH_USERNAME and OPENSEARCH_PASSWORD from the Aiven service credentials.
# Put Aiven ca.pem, service.cert, and service.key under certs/ (never commit them).

# Aiven service connection strings (replace localhost values above for production)
# PostgreSQL:
# PG_DSN=postgresql://avnadmin:[REDACTED]@pulsecart-12115-phoenixeyev5-11e7.h.aivencloud.com:27571/defaultdb?sslmode=require
# Kafka (SASL auth on port 27584):
# KAFKA_BOOTSTRAP=pulsecart-kafka-12115-phoenixeyev5-11e7.j.aivencloud.com:27584
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=[REDACTED]
# Kafka (client cert auth on port 27573 - alternative to SASL):
# KAFKA_BOOTSTRAP=pulsecart-kafka-12115-phoenixeyev5-11e7.j.aivencloud.com:27573
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_CA=certs/aiven-ca.pem
# KAFKA_CERT=certs/aiven-service.cert
# KAFKA_KEY=certs/aiven-service.key
# OpenSearch:
# OPENSEARCH_URL=https://avnadmin:[REDACTED]@pulsecart-os-12115-phoenixeyev5-11e7.d.aivencloud.com:27571
# OPENSEARCH_USERNAME=avnadmin
# OPENSEARCH_PASSWORD=[REDACTED]
# OPENSEARCH_VERIFY_CERTS=true

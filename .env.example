# Local Compose uses its own service URLs. These settings are for running processes locally.
PG_DSN=postgresql://postgres:postgres@localhost:5432/pulsecart
KAFKA_BOOTSTRAP=localhost:9093
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CA=certs/ca.pem
KAFKA_CERT=certs/service.cert
KAFKA_KEY=certs/service.key
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
API_CORS_ORIGINS=http://localhost:3000
APP_ENV=production
ADMIN_KEY=

# For Aiven, replace the service URLs above. Add ?sslmode=require to PG_DSN,
# KAFKA_SECURITY_PROTOCOL=SSL
# Set OPENSEARCH_USERNAME and OPENSEARCH_PASSWORD from the Aiven service credentials.
# Put Aiven ca.pem, service.cert, and service.key under certs/ (never commit them).
